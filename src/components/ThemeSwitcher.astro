---
const themes = [
  { label: 'Violet', value: 'violet' },
  { label: 'Forest', value: 'forest' },
  { label: 'Amber', value: 'amber' },
  { label: 'Ocean', value: 'ocean' },
  { label: 'Rose', value: 'rose' },
  { label: 'Dark', value: 'dark' },
];
---

<details class="theme-switcher">
  <summary class="theme-switcher__trigger">
    <span class="theme-switcher__sr-only">Theme</span>
  </summary>

  <div class="theme-switcher__inline" role="group" aria-label="Color themes">
    {themes.map((theme) => (
      <button
        type="button"
        class="theme-switcher__button"
        data-theme-select={theme.value}
        aria-label={`Switch to ${theme.label} theme`}
        title={theme.label}
      >
        <span class={`theme-switcher__swatch theme-switcher__swatch--${theme.value}`}></span>
      </button>
    ))}
  </div>
</details>

<style>
  .theme-switcher {
    display: block;
    position: relative;
    border-radius: 999px;
    width: 2.125rem;
    height: 2.125rem;
    background: transparent;
    box-shadow: none;
  }

  .theme-switcher[open] {
    overflow: visible;
  }

  .theme-switcher__trigger {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    width: 2.125rem;
    height: 2.125rem;
    padding: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    user-select: none;
    transition: box-shadow 180ms ease, border-color 180ms ease;
  }

  .theme-switcher__trigger::before {
    content: '';
    width: 0.78rem;
    height: 0.78rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 92%, white);
  }

  .theme-switcher__trigger:hover,
  .theme-switcher__trigger:focus-visible {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 10%, transparent);
    outline: none;
  }

  .theme-switcher__trigger::-webkit-details-marker {
    display: none;
  }

  .theme-switcher__inline {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.38rem;
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    z-index: 1;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-elevated) 96%, transparent);
    box-shadow:
      0 10px 24px rgba(16, 24, 40, 0.08),
      inset 0 0 0 1px color-mix(in srgb, var(--border-subtle) 72%, transparent);
    backdrop-filter: blur(10px);
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .theme-switcher[open] .theme-switcher__inline {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .theme-switcher__button {
    width: 1.7rem;
    height: 1.7rem;
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--border-subtle) 72%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-2) 82%, transparent);
    padding: 0;
    cursor: pointer;
    transition: transform 150ms ease, border-color 150ms ease, background-color 150ms ease, box-shadow 150ms ease;
  }

  .theme-switcher__button:hover,
  .theme-switcher__button:focus-visible {
    transform: translateY(-1px);
    border-color: var(--accent-soft);
    outline: none;
  }

  .theme-switcher__button.is-active {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 38%, transparent);
  }

  .theme-switcher__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .theme-switcher__swatch {
    width: 0.82rem;
    height: 0.82rem;
    border-radius: 999px;
    display: block;
  }

  .theme-switcher__swatch--violet {
    background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  }

  .theme-switcher__swatch--forest {
    background: linear-gradient(135deg, #19765d, #5cb39b);
  }

  .theme-switcher__swatch--amber {
    background: linear-gradient(135deg, #b06e26, #d5aa74);
  }

  .theme-switcher__swatch--dark {
    background: linear-gradient(135deg, #0b0b0a 0%, #151410 58%, #b89a5e 100%);
  }

  .theme-switcher__swatch--ocean {
    background: linear-gradient(135deg, #257aa8, #66b8de);
  }

  .theme-switcher__swatch--rose {
    background: linear-gradient(135deg, #be5e84, #e2a1b7);
  }

  @media (max-width: 900px) {
    .theme-switcher__inline {
      top: calc(100% + 0.35rem);
      right: 0;
    }
  }
</style>
