---
import { Mail } from '@lucide/astro';
---

<section class="newsletter-strip" aria-labelledby="newsletter-title">
  <div class="newsletter-strip__lead">
    <div class="newsletter-strip__icon">
      <Mail size={20} />
    </div>
    <div>
      <h2 id="newsletter-title">Get new posts and updates in your inbox.</h2>
      <p>No spam. Just thoughtful notes when I publish.</p>
    </div>
  </div>

  <form class="newsletter-strip__form">
    <label class="newsletter-strip__sr-only" for="email">Your email address</label>
    <input id="email" type="email" name="email" placeholder="Your email address" />
    <button type="submit">Subscribe</button>
  </form>
</section>

<style>
  .newsletter-strip {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1rem;
    padding: 1.2rem 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-4);
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent-soft) 10%, var(--surface-2)), var(--surface-1));
    box-shadow: var(--shadow-1);
  }

  .newsletter-strip__lead {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .newsletter-strip__icon {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    color: var(--accent);
    border-radius: var(--radius-3);
    background: color-mix(in srgb, var(--accent-soft) 22%, var(--surface-1));
  }

  .newsletter-strip h2,
  .newsletter-strip p {
    margin: 0;
  }

  .newsletter-strip h2 {
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }

  .newsletter-strip p {
    color: var(--text-2);
  }

  .newsletter-strip__form {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .newsletter-strip__form input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-3);
    background: var(--surface-1);
    color: var(--text-1);
    padding: 0.9rem 1rem;
    font: inherit;
  }

  .newsletter-strip__form button {
    border: 0;
    border-radius: var(--radius-3);
    background: var(--accent-strong);
    color: var(--button-text);
    padding: 0.9rem 1.2rem;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .newsletter-strip__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1023px) {
    .newsletter-strip {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 639px) {
    .newsletter-strip__form {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
